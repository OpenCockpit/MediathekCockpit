- param: {name: "width"}
- param: {name: "height"}
- widget:
    font: "$md_body_large"
    name: "epg_description"
    position: "0,0"
    scrollbarMode: "showOnDemand"
    size: "$width,$height-34"
    transparent: "1"
- widget:
    font: "$md_body_large"
    halign: "left"
    name: "datetime"
    position: "0,$height-40"
    size: "$width,40"
    transparent: "1"
- widget:
    font: "$md_body_large"
    halign: "center"
    name: "duration"
    position: "0,$height-40"
    size: "$width,40"
    transparent: "1"
- widget:
    font: "$md_body_large"
    halign: "right"
    name: "channel"
    position: "0,$height-40"
    size: "$width,40"
    transparent: "1"
