screen:
  backgroundColor: "panelBG"
  flags: "wfNoBorder"
  name: "MediathekCockpit"
  position: "center,center"
  resolution: "1920,1080"
  size: "1920,1080"
  title: "MediathekCockpit"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - xmlinc:
