screen:
  backgroundColor: "panelBG"
  flags: "wfNoBorder"
  name: "EventInfo"
  position: "center,center"
  size: "1280,720"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        font: "$FR_medium"
        name: "epg_description"
        position: "10,65"
        scrollbarMode: "showOnDemand"
        size: "e-20,e-190"
        transparent: "1"
    - widget:
        font: "$FR_medium"
        halign: "left"
        name: "datetime"
        position: "10,e-115"
        size: "e-20,35"
        transparent: "1"
    - widget:
        font: "$FR_medium"
        halign: "center"
        name: "duration"
        position: "10,e-115"
        size: "e-20,35"
        transparent: "1"
    - widget:
        font: "$FR_medium"
        halign: "right"
        name: "channel"
        position: "10,e-115"
        size: "e-20,35"
        transparent: "1"
    - xmlinc:
        file: "screenpart_BottomBar.ymlinc"
    - xmlinc:
        file: "screenpart_ButtonBar.ymlinc"
        position: "0,$screen_height-48"
