screen:
  backgroundColor: "md_transparent"
  name: "EventInfo"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Wide.ymlinc"
        position: "252,111"
    - widget:
        font: "$md_body_large"
        name: "epg_description"
        position: "14,72"
        scrollbarMode: "showOnDemand"
        size: "1388,630"
        transparent: "1"
    - widget:
        font: "$md_body_large"
        halign: "left"
        name: "datetime"
        position: "14,725"
        size: "1388,35"
        transparent: "1"
    - widget:
        font: "$md_body_large"
        halign: "center"
        name: "duration"
        position: "14,725"
        size: "1388,35"
        transparent: "1"
    - widget:
        font: "$md_body_large"
        halign: "right"
        name: "channel"
        position: "14,725"
        size: "1388,35"
        transparent: "1"
