widget:
  backgroundColorSelected: "$backgroundColorSelected"
  itemCornerRadiusSelected: "$radius_item"
  position: "0,0"
  render: "Listbox"
  scrollbarMode: "showOnDemand"
  size: "1200,910"
  source: "list"
  transparent: "1"
  children:
    - convert:
        type: "TemplatedMultiContentEx"
        cell:
          itemHeight: 70
          fonts:
            - "$list_font"
            - "$caption_font"
            - "$label_font"
          fields:
            - text:
                position: "75,0"
                size: "170,34"
                font: "$list_font"
                flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                value: 0
            - icon:
                position: "4,0"
                size: "60,60"
                flags: BT_SCALE|BT_KEEP_ASPECT_RATIO|BT_HALIGN_CENTER|BT_VALIGN_CENTER
                value: 8
            - text:
                position: "75,35"
                size: "110,30"
                font: "$caption_font"
                flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                value: 5
            - text:
                position: "200,35"
                size: "70,30"
                font: "$caption_font"
                flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                value: 4
            - text:
                position: "300,0"
                size: "890,36"
                font: "$list_font"
                flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                value: 15
            - text:
                position: "300,35"
                size: "890,30"
                font: "$label_font"
                flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                value: 16
                color: "md_on_surface_variant"
                color_sel: "md_on_surface_variant"
