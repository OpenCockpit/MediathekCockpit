widget:
  backgroundColorSelected: "keyBlue"
  position: "0,0"
  render: "Listbox"
  scrollbarMode: "showOnDemand"
  size: "1200,910"
  source: "list"
  transparent: "1"
  children:
    - convert:
        type: "TemplatedMultiContent"
        cell:
          itemHeight: 70
          fonts:
            - "Regular;30"
            - "Regular;26"
            - "Regular;20"
          fields:
            - text:
                rect: [75, 0, 170, 34]
                font: "Regular;30"
                flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                value: 0
            - icon:
                rect: [4, 0, 60, 60]
                flags: BT_SCALE|BT_KEEP_ASPECT_RATIO|BT_HALIGN_CENTER|BT_VALIGN_CENTER
                value: 8
            - text:
                rect: [75, 35, 110, 30]
                font: "Regular;20"
                flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                value: 5
            - text:
                rect: [200, 35, 70, 30]
                font: "Regular;20"
                flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                value: 4
            - text:
                rect: [300, 0, 890, 36]
                font: "Regular;30"
                flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                value: 15
            - raw:
                call: MultiContentEntryText
                kwargs:
                  pos: [300, 35]
                  size: [890, 30]
                  font: {call: gFont, args: ["Regular", 26]}
                  flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                  text: 16
                  color: 0xa0a0a0
                  color_sel: 0xa0a0a0
                  backcolor: null
