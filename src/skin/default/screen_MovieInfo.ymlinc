screen:
  backgroundColor: "md_transparent"
  name: "MovieInfo"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Wide.ymlinc"
        position: "252,111"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "14,72"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1388,650"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "COCTemplatedMultiContentEx"
              cell:
                itemHeight: 65
                fonts:
                  - "$md_body_small"
                fields:
                  - text:
                      position: "5,0"
                      size: "320,62"
                      flags: RT_VALIGN_CENTER
                      value: 0
                  - text:
                      position: "335,0"
                      size: "1040,62"
                      flags: RT_VALIGN_CENTER|RT_WRAP
                      value: 1
