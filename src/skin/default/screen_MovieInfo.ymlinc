screen:
  name: "MovieInfo"
  position: "center,center"
  size: "1280,720"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "10,65"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "e-20,590"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "COCTemplatedMultiContentEx"
              cell:
                itemHeight: 65
                fonts:
                  - "$md_body_small"
                fields:
                  - text:
                      position: "5,0"
                      size: "320,62"
                      flags: RT_VALIGN_CENTER
                      value: 0
                  - text:
                      position: "335,0"
                      size: "920,62"
                      flags: RT_VALIGN_CENTER|RT_WRAP
                      value: 1
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
