screen:
  backgroundColor: "panelBG"
  flags: "wfNoBorder"
  name: "MovieInfo"
  position: "center,center"
  size: "1280,720"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        enableWrapAround: "1"
        position: "10,65"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "e-20,590"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContent"
              cell:
                itemHeight: 65
                fonts:
                  - "Regular;24"
                fields:
                  - text:
                      rect: [5, 0, 320, 62]
                      flags: RT_VALIGN_CENTER
                      value: 0
                  - text:
                      rect: [335, 0, 920, 62]
                      flags: RT_VALIGN_CENTER|RT_WRAP
                      value: 1
    - xmlinc:
        file: "screenpart_BottomBar.ymlinc"
    - xmlinc:
        file: "screenpart_ButtonBar.ymlinc"
        position: "0,$screen_height-48"
