- param: {name: "width"}
- param: {name: "height"}
- eLabel:
    backgroundColor: "md_outline_variant"
    position: "$width-640-10,0"
    size: "1,$height"
    zPosition: "-5"
# the list of the programs: a row a program, with its picture over both lines on the left, the channel (date and time
# under it) and the title (the description under it)
- widget:
    render: "Listbox"
    backgroundColorSelected: "$backgroundColorSelected"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "1200,eval(($height-35)/62*62)"
    source: "list"
    children:
      - convert:
          type: "COCTemplatedMultiContentEx"
          cell:
            itemHeight: 62
            fonts: ["$md_body_medium", "$md_label_medium", "$md_body_small"]
            fields:
              - icon:
                  flags: "BT_SCALE|BT_KEEP_ASPECT_RATIO|BT_HALIGN_CENTER|BT_VALIGN_CENTER"
                  value: 8
                  position: "10,0"
                  size: "60,60"
              - text:
                  font: "$md_body_medium"
                  flags: "RT_HALIGN_LEFT|RT_VALIGN_CENTER"
                  value: 0
                  position: "85,0"
                  size: "170,32"
              - text:
                  font: "$md_body_medium"
                  flags: "RT_HALIGN_LEFT|RT_VALIGN_CENTER"
                  value: 15
                  position: "290,0"
                  size: "900,32"
              - text:
                  font: "$md_label_medium"
                  flags: "RT_HALIGN_LEFT|RT_VALIGN_CENTER"
                  value: 5
                  position: "85,32"
                  size: "110,30"
              - text:
                  font: "$md_label_medium"
                  flags: "RT_HALIGN_LEFT|RT_VALIGN_CENTER"
                  value: 4
                  position: "210,32"
                  size: "70,30"
              - text:
                  font: "$md_body_small"
                  flags: "RT_HALIGN_LEFT|RT_VALIGN_CENTER"
                  value: 16
                  color: "md_on_surface_variant"
                  color_sel: "md_inverse_on_surface"
                  position: "290,32"
                  size: "900,30"
- widget:
    font: "$md_body_medium"
    name: "duration"
    position: "$width-640,0"
    size: "640,38"
    transparent: "1"
    zPosition: "1"
- widget:
    font: "$md_body_small"
    name: "description"
    position: "$width-640,45"
    size: "640,$height-45"
    transparent: "1"
    zPosition: "1"
- widget:
    addon: "COCPager"
    backgroundColor: "md_surface"
    conditional: "pages"
    connection: "pages"
    position: "0,$height-25"
    size: "1200,25"
    transparent: "1"
