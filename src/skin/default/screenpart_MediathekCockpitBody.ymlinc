- widget:
    backgroundColorSelected: "$backgroundColorSelected"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showOnDemand"
    size: "1200,eval($height/69*69)"
    source: "list"
    transparent: "1"
    children:
      - convert:
          type: "COCTemplatedMultiContentEx"
          cell:
            itemHeight: 69
            fonts:
              - "$md_body_medium"
              - "$md_label_medium"
              - "$md_body_small"
            fields:
              - text:
                  position: "75,0"
                  size: "170,32"
                  font: "$md_body_medium"
                  flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                  value: 0
              - icon:
                  position: "4,0"
                  size: "60,60"
                  flags: BT_SCALE|BT_KEEP_ASPECT_RATIO|BT_HALIGN_CENTER|BT_VALIGN_CENTER
                  value: 8
              - text:
                  position: "75,34"
                  size: "110,28"
                  font: "$md_label_medium"
                  flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                  value: 5
              - text:
                  position: "200,34"
                  size: "70,28"
                  font: "$md_label_medium"
                  flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                  value: 4
              - text:
                  position: "300,0"
                  size: "890,32"
                  font: "$md_body_medium"
                  flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                  value: 15
              - text:
                  position: "300,34"
                  size: "890,28"
                  font: "$md_body_small"
                  flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                  value: 16
                  color: "md_on_surface_variant"
                  color_sel: "md_on_surface_variant"
- widget:
    font: "$md_body_medium"
    name: "duration"
    position: "$width-640,0"
    size: "640,32"
    transparent: "1"
    zPosition: "1"
- widget:
    font: "$md_body_small"
    name: "description"
    position: "$width-640,45"
    size: "640,$height-45"
    transparent: "1"
    zPosition: "1"
