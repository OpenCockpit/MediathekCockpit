- param: {name: "width"}
- param: {name: "height"}
# the information of a movie: a row an item, its name on the left, its value on the right
- widget:
    render: "Listbox"
    backgroundColorSelected: "$backgroundColorSelected"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "0,0"
    size: "$width,eval($height//$list_item_height*$list_item_height)"
    source: "list"
    children:
      - convert:
          type: "COCTemplatedMultiContentEx"
          cell:
            itemHeight: "$list_item_height"
            fonts: ["$md_body_small"]
            fields:
              - text:
                  flags: "RT_VALIGN_CENTER"
                  value: 0
                  position: "5,0"
                  size: "320,$list_item_height"
              - text:
                  flags: "RT_VALIGN_CENTER"
                  value: 1
                  position: "335,0"
                  size: "($width-5-5)-320-1*10,$list_item_height"
